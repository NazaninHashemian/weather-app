{
  "compilerOptions": {
    "jsx": "react",
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "./dist",  // Specifies the directory where the compiled JavaScript will go
    
    /* Strict Type Checking Options */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    /* Optional for Additional Customizations */
    "incremental": true,  // Enable incremental compilation for faster rebuilds
    "moduleResolution": "node",  // Resolve modules in the same way Node.js does
    "resolveJsonModule": true  // Allow importing JSON files as modules
  }
}
